# Get this from @BotFather with /newbot
BOT_TOKEN=

# Public HTTPS URL where webapp/dist is hosted.
# Must be HTTPS — Telegram will not open an http:// Mini App.
# e.g. https://sanjar29.github.io/prava-en/
WEBAPP_URL=

# Hour (Asia/Tashkent, 0-23) to send the question of the day
DAILY_HOUR=9

# Where the JSON user store lives
DATA_FILE=./data/users.json
